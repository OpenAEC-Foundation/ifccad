{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ifccad.org/ifcx/ifccad-drawing-core-0.2.0.json",
  "title": "IFCCAD IFCX Drawing Core 0.2.0",
  "description": "Local shape constraints for the extensible IFCCAD drawing spine and typed appearance backbone in IFCX.",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataNode"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "dataNode": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "openaec:DrawingSet"}}
          },
          "then": {"$ref": "#/$defs/drawingSetNode"}
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "openaec:Drawing"}}
          },
          "then": {"$ref": "#/$defs/drawingNode"}
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "openaec:DrawingLayout"}}
          },
          "then": {"$ref": "#/$defs/drawingLayoutNode"}
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "openaec:Layer"}}
          },
          "then": {"$ref": "#/$defs/layerNode"}
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "openaec:Appearance"}}
          },
          "then": {"$ref": "#/$defs/appearanceNode"}
        }
      ],
      "additionalProperties": true
    },
    "drawingSetNode": {
      "type": "object",
      "required": ["path", "type", "children"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "openaec:DrawingSet"},
        "attributes": {"type": "object"},
        "children": {
          "type": "object",
          "required": ["Drawings"],
          "properties": {
            "Drawings": {"$ref": "#/$defs/nodeReferenceArray"},
            "PreservationResources": {"$ref": "#/$defs/nodeReferenceArray"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "drawingNode": {
      "type": "object",
      "required": ["path", "type", "children"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "openaec:Drawing"},
        "attributes": {"type": "object"},
        "children": {
          "type": "object",
          "required": ["Representation", "Layouts"],
          "properties": {
            "Representation": {"$ref": "#/$defs/nodeReference"},
            "Layouts": {
              "allOf": [
                {"$ref": "#/$defs/nodeReferenceArray"},
                {"minItems": 1}
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "drawingLayoutNode": {
      "type": "object",
      "required": ["path", "type", "attributes", "children"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "openaec:DrawingLayout"},
        "attributes": {
          "type": "object",
          "required": ["name", "kind", "scopeId"],
          "properties": {
            "name": {"$ref": "#/$defs/nonEmptyString"},
            "kind": {"enum": ["model", "paper"]},
            "scopeId": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        "children": {
          "type": "object",
          "required": ["Representation"],
          "properties": {
            "Representation": {"$ref": "#/$defs/nodeReference"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "layerNode": {
      "type": "object",
      "required": ["path", "type", "attributes"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "openaec:Layer"},
        "attributes": {
          "type": "object",
          "required": ["name", "visible"],
          "properties": {
            "name": {"$ref": "#/$defs/nonEmptyString"},
            "visible": {"type": "boolean"},
            "appearance": {"$ref": "#/$defs/nodeReference"}
          },
          "additionalProperties": true
        },
        "children": {"type": "object"}
      },
      "additionalProperties": true
    },
    "appearanceNode": {
      "type": "object",
      "required": ["path", "type", "attributes"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "openaec:Appearance"},
        "attributes": {
          "type": "object",
          "required": ["name", "color", "opacity", "linePattern", "lineWeight"],
          "properties": {
            "name": {"$ref": "#/$defs/nonEmptyString"},
            "color": {"$ref": "#/$defs/explicitColor"},
            "opacity": {"$ref": "#/$defs/explicitOpacity"},
            "linePattern": {"$ref": "#/$defs/explicitLinePattern"},
            "lineWeight": {"$ref": "#/$defs/explicitLineWeight"}
          },
          "additionalProperties": true
        },
        "children": {"type": "object"}
      },
      "additionalProperties": true
    },
    "explicitColor": {
      "type": "object",
      "required": ["mode", "value"],
      "properties": {
        "mode": {"const": "explicit"},
        "value": {
          "type": "object",
          "required": ["rgb"],
          "properties": {
            "rgb": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer", "minimum": 0, "maximum": 255}
            },
            "indexedColor": {
              "type": "object",
              "required": ["system", "index"],
              "properties": {
                "system": {"$ref": "#/$defs/nonEmptyString"},
                "index": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": true
            },
            "namedColor": {
              "type": "object",
              "required": ["catalog", "name"],
              "properties": {
                "catalog": {"$ref": "#/$defs/nonEmptyString"},
                "name": {"$ref": "#/$defs/nonEmptyString"}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "explicitOpacity": {
      "type": "object",
      "required": ["mode", "value"],
      "properties": {
        "mode": {"const": "explicit"},
        "value": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "explicitLinePattern": {
      "type": "object",
      "required": ["mode", "value"],
      "properties": {
        "mode": {"const": "explicit"},
        "value": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": true
    },
    "explicitLineWeight": {
      "type": "object",
      "required": ["mode", "value"],
      "properties": {
        "mode": {"const": "explicit"},
        "value": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "nodeReference": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "nodeReferenceArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nodeReference"}
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
