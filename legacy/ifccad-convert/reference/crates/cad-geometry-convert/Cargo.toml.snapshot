[package]
name = "cad-geometry-convert"
version.workspace = true
publish = false
edition = "2021"
license = "MPL-2.0"
description = "Shared geometric preparation and certified CAD conversion accuracy"

[dependencies]
ifccad = { path = "../.." }
opencadcodec = { package = "acadrust", git = "https://github.com/HakanSeven12/opencadcodec.git", rev = "bd10efc2c54dfe1e6288c5f10486dce9be0d7f32" }
fpmath = "=0.1.1"
num-bigint = "0.4"
num-rational = "0.4"
num-traits = "0.2"
thiserror = "1"

[dev-dependencies]
serde_json = '1'
