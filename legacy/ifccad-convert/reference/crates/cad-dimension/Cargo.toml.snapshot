[package]
name = "cad-dimension"
version.workspace = true
publish = false
edition = "2021"
license = "MPL-2.0"
description = "Typed CAD dimension styles, overrides and geometric preparation"

[dependencies]
ifccad = { path = "../.." }
cad-geometry-convert = { path = "../cad-geometry-convert" }
cad-presentation-convert = { path = "../cad-presentation-convert" }
opencadcodec = { package = "acadrust", git = "https://github.com/HakanSeven12/opencadcodec.git", rev = "bd10efc2c54dfe1e6288c5f10486dce9be0d7f32" }
num-rational = "0.4"
num-traits = "0.2"
fpmath = "=0.1.1"
thiserror = "1"

[dev-dependencies]
serde_json = "1"
