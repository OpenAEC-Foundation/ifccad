[package]
name = "cad-workspace-convert"
version.workspace = true
publish = false
edition = "2021"
license = "MPL-2.0"
description = "Shared CAD drawing workspace field conversion"

[dependencies]
ifccad = { path = "../.." }
opencadcodec = { package = "acadrust", git = "https://github.com/HakanSeven12/opencadcodec.git", rev = "bd10efc2c54dfe1e6288c5f10486dce9be0d7f32", features = ["serde"] }
thiserror = "1"

[dev-dependencies]
serde_json = "1"
