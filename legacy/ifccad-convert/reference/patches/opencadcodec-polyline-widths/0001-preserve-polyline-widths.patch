+//! Physical output must retain classic dependency state and noncompeting controls.
+use acadrust::entities::LwPolyline;
+use acadrust::types::{DxfVersion, Vector2};
+use acadrust::{
+    CadDocument, DwgReader, DwgWriter, DxfReader, DxfWriter, EntityType, Polyline2DWriteMode,
+};
+use std::io::Cursor;
+fn fixture() -> CadDocument {
+    DxfReader::from_reader(Cursor::new(
+        include_bytes!("fixtures/polyline-width-defaults.dxf").to_vec(),
+    ))
+    .unwrap()
+    .read()
+    .unwrap()
+}
+// Independent group-code oracle: no entity reader or writer helpers.
+fn tags(bytes: &[u8]) -> Vec<(i32, String)> {
+    if !bytes.starts_with(b"AutoCAD Binary DXF") {
+        let lines: Vec<_> = std::str::from_utf8(bytes).unwrap().lines().collect();
+        return lines
+            .chunks_exact(2)
+            .map(|p| (p[0].trim().parse().unwrap(), p[1].trim().to_owned()))
+            .collect();
+    }
+    let mut i = 22;
+    let mut pairs = Vec::new();
+    while i < bytes.len() {
+        let code = u16::from_le_bytes(bytes[i..i + 2].try_into().unwrap()) as i32;
+        i += 2;
+        let size = match code {
+            10..=59 | 110..=149 | 210..=239 | 460..=469 | 1010..=1059 => 8,
+            60..=79 | 170..=179 | 270..=279 | 370..=389 | 400..=409 | 1060..=1070 => 2,
+            90..=99 | 420..=429 | 440..=459 | 1071 => 4,
+            160..=169 => 8,
+            280..=289 | 290..=299 => 1,
+            310..=319 | 1004 => {
+                let n = bytes[i] as usize;
+                i += 1;
+                i += n;
+                pairs.push((code, String::new()));
+                continue;
+            }
+            _ => 0,
+        };
+        let value = if size == 0 {
+            let n = bytes[i..].iter().position(|b| *b == 0).unwrap();
+            let s = String::from_utf8_lossy(&bytes[i..i + n]).into_owned();
+            i += n + 1;
+            s
+        } else {
+            let data = &bytes[i..i + size];
+            i += size;
+            if matches!(code,10..=59|110..=149|210..=239|460..=469|1010..=1059) {
+                f64::from_le_bytes(data.try_into().unwrap()).to_string()
+            } else {
+                String::new()
+            }
+        };
+        let eof = code == 0 && value == "EOF";
+        pairs.push((code, value));
+        if eof {
+            break;
+        }
+    }
+    pairs
+}
+
+fn records(tags: &[(i32, String)], kind: &str) -> Vec<Vec<(i32, String)>> {
+    let mut result = Vec::new();
+    let mut current = None;
+    for pair in tags {
+        if pair.0 == 0 {
+            if let Some(r) = current.take() {
+                result.push(r)
+            };
+            if pair.1 == kind {
+                current = Some(Vec::new())
+            }
+        } else if let Some(r) = &mut current {
+            r.push(pair.clone())
+        }
+    }
+    if let Some(r) = current {
+        result.push(r)
+    }
+    result
+}
+#[test]
+fn classic_ascii_and_binary_keep_header_and_vertex_presence() {
+    let doc = fixture();
+    for binary in [false, true] {
+        let mut writer =
+            DxfWriter::new(&doc).with_polyline2d_write_mode(Polyline2DWriteMode::PreserveClassic);
+        writer.set_binary(binary);
+        let bytes = writer.write_to_vec().unwrap();
+        {
+            let pairs = tags(&bytes);
+            let vertices = records(&pairs, "VERTEX");
+            assert_eq!(vertices.len(), 4);
+            let widths: Vec<_> = vertices
+                .iter()
+                .map(|r| {
+                    r.iter()
+                        .filter(|p| p.0 == 40 || p.0 == 41)
+                        .map(|(c, v)| (*c, v.parse::<f64>().unwrap()))
+                        .collect::<Vec<_>>()
+                })
+                .collect();
+            assert_eq!(
+                widths,
+                vec![
+                    vec![],
+                    vec![(40, 0.)],
+                    vec![(41, 0.)],
+                    vec![(40, 0.2), (41, 0.4)]
+                ]
+            );
+            let header = records(&pairs, "POLYLINE");
+            assert_eq!(header.len(), 1);
+            assert!(header[0].contains(&(40, "0.2".into())));
+            assert!(header[0].contains(&(41, "0.4".into())));
+        }
+        let reread = DxfReader::from_reader(Cursor::new(bytes))
+            .unwrap()
+            .read()
+            .unwrap();
+        let p = reread
+            .entities()
+            .find_map(|e| {
+                if let EntityType::Polyline2D(p) = e {
+                    Some(p)
+                } else {
+                    None
+                }
+            })
+            .unwrap();
+        assert_eq!([p.start_width, p.end_width], [0.2, 0.4]);
+        assert_eq!(
+            p.vertices
+                .iter()
+                .map(|v| (v.start_width, v.end_width))
+                .collect::<Vec<_>>(),
+            vec![
+                (None, None),
+                (Some(0.), None),
+                (None, Some(0.)),
+                (Some(0.2), Some(0.4))
+            ]
+        );
+    }
+}
+#[test]
+fn constant_lw_emits_43_without_40_41() {
+    let mut doc = CadDocument::new();
+    let mut p = LwPolyline::from_points(vec![Vector2::new(0., 0.), Vector2::new(10., 0.)]);
+    p.constant_width = 0.15;
+    doc.add_entity(EntityType::LwPolyline(p)).unwrap();
+    let pairs = tags(&DxfWriter::new(&doc).write_to_vec().unwrap());
+    let rs = records(&pairs, "LWPOLYLINE");
+    assert_eq!(rs.len(), 1);
+    assert!(rs[0].contains(&(43, "0.15".into())));
+    assert!(!rs[0].iter().any(|p| p.0 == 40 || p.0 == 41));
+}
+#[test]
+fn conflicting_constant_and_vertex_controls_are_refused() {
+    let mut doc = CadDocument::new();
+    let mut p = LwPolyline::from_points(vec![Vector2::new(0., 0.), Vector2::new(10., 0.)]);
+    p.constant_width = 0.15;
+    p.vertices[0].end_width = 0.2;
+    doc.add_entity(EntityType::LwPolyline(p)).unwrap();
+    assert!(DxfWriter::new(&doc).write_to_vec().is_err());
+}
+#[test]
+fn dwg_materializes_absent_vertex_widths_without_invented_flags() {
+    let doc = fixture();
+    let bytes = DwgWriter::write_to_vec(&doc).unwrap();
+    let reread = DwgReader::from_stream(Cursor::new(bytes)).read().unwrap();
+    let p = reread
+        .entities()
+        .find_map(|e| {
+            if let EntityType::Polyline2D(p) = e {
+                Some(p)
+            } else {
+                None
+            }
+        })
+        .unwrap();
+    assert_eq!([p.start_width, p.end_width], [0.2, 0.4]);
+    assert_eq!(
+        p.vertices
+            .iter()
+            .map(|v| (v.start_width, v.end_width))
+            .collect::<Vec<_>>(),
+        vec![
+            (Some(0.2), Some(0.4)),
+            (Some(0.), Some(0.4)),
+            (Some(0.2), Some(0.)),
+            (Some(0.2), Some(0.4))
+        ]
+    );
+}
+#[test]
+fn actual_binary_header_version_is_recorded() {
+    let doc = fixture();
+    for (request, actual) in [
+        (DxfVersion::AC1015, DxfVersion::AC1024),
+        (DxfVersion::AC1018, DxfVersion::AC1024),
+        (DxfVersion::AC1021, DxfVersion::AC1021),
+        (DxfVersion::AC1024, DxfVersion::AC1024),
+        (DxfVersion::AC1027, DxfVersion::AC1027),
+        (DxfVersion::AC1032, DxfVersion::AC1032),
+    ] {
+        let bytes = DxfWriter::new_binary(&doc)
+            .with_version(request)
+            .with_polyline2d_write_mode(Polyline2DWriteMode::PreserveClassic)
+            .write_to_vec()
+            .unwrap();
+        let read = DxfReader::from_reader(Cursor::new(bytes))
+            .unwrap()
+            .read()
+            .unwrap();
+        assert_eq!(read.version, actual);
+    }
+}
+
+#[test]
+fn preserve_classic_allocates_distinct_vertex_seqend_handles() {
+    use acadrust::entities::{Insert, Line};
+    use acadrust::tables::{BlockRecord, TableEntry};
+    use acadrust::types::Vector3;
+    let mut doc = fixture();
+    let source = doc
+        .entities()
+        .find_map(|e| {
+            if let EntityType::Polyline2D(p) = e {
+                Some(p.clone())
+            } else {
+                None
+            }
+        })
+        .unwrap();
+    let mut block = BlockRecord::new("WideMarker");
+    block.set_handle(doc.allocate_handle());
+    let block_handle = block.handle;
+    block.block_entity_handle = doc.allocate_handle();
+    block.block_end_handle = doc.allocate_handle();
+    doc.block_records.add(block).unwrap();
+    let mut marker = source;
+    marker.common.handle = Default::default();
+    marker.common.owner_handle = block_handle;
+    doc.add_entity(EntityType::Polyline2D(marker)).unwrap();
+    doc.add_entity(EntityType::Insert(Insert::new("WideMarker", Vector3::ZERO)))
+        .unwrap();
+    doc.add_entity(EntityType::Line(Line::new())).unwrap();
+    let bytes = DxfWriter::new(&doc)
+        .with_polyline2d_write_mode(Polyline2DWriteMode::PreserveClassic)
+        .write_to_vec()
+        .unwrap();
+    let pairs = tags(&bytes);
+    let mut handles = std::collections::HashSet::new();
+    for (c, v) in &pairs {
+        if *c == 5 || *c == 105 {
+            assert!(handles.insert(v.to_uppercase()), "duplicate handle {v}");
+        }
+    }
+    let parents: std::collections::HashSet<_> = records(&pairs, "POLYLINE")
+        .iter()
+        .map(|r| r.iter().find(|p| p.0 == 5).unwrap().1.clone())
+        .collect();
+    assert_eq!(parents.len(), 2);
+    assert_eq!(records(&pairs, "VERTEX").len(), 8);
+    assert_eq!(records(&pairs, "SEQEND").len(), 2);
+    for r in records(&pairs, "VERTEX")
+        .into_iter()
+        .chain(records(&pairs, "SEQEND"))
+    {
+        assert!(parents.contains(&r.iter().find(|p| p.0 == 330).unwrap().1));
+    }
+    DxfReader::from_reader(Cursor::new(bytes))
+        .unwrap()
+        .read()
+        .unwrap();
+}
+
+#[test]
+fn classic_defaults_and_constant_signed_zero_survive_dxf() {
+    let mut doc = fixture();
+    let p = doc
+        .entities_mut()
+        .find_map(|e| {
+            if let EntityType::Polyline2D(p) = e {
+                Some(p)
+            } else {
+                None
+            }
+        })
+        .unwrap();
+    p.start_width = -0.0;
+    p.vertices[0].start_width = Some(-0.0);
+    let mut lw = LwPolyline::from_points(vec![Vector2::new(0., 0.), Vector2::new(1., 0.)]);
+    lw.constant_width = -0.0;
+    doc.add_entity(EntityType::LwPolyline(lw)).unwrap();
+    for binary in [false, true] {
+        let mut w =
+            DxfWriter::new(&doc).with_polyline2d_write_mode(Polyline2DWriteMode::PreserveClassic);
+        w.set_binary(binary);
+        let bytes = w.write_to_vec().unwrap();
+        let parsed = tags(&bytes);
+        let lw = records(&parsed, "LWPOLYLINE");
+        assert!(!lw[0].iter().any(|p| p.0 == 40 || p.0 == 41));
+        let back = DxfReader::from_reader(Cursor::new(bytes))
+            .unwrap()
+            .read()
+            .unwrap();
+        let p = back
+            .entities()
+            .find_map(|e| {
+                if let EntityType::Polyline2D(p) = e {
+                    Some(p)
+                } else {
+                    None
+                }
+            })
+            .unwrap();
+        assert_eq!(p.start_width.to_bits(), (-0.0f64).to_bits());
+        assert_eq!(
+            p.vertices[0].start_width.unwrap().to_bits(),
+            (-0.0f64).to_bits()
+        );
+        let p = back
+            .entities()
+            .find_map(|e| {
+                if let EntityType::LwPolyline(p) = e {
+                    Some(p)
+                } else {
+                    None
+                }
+            })
+            .unwrap();
+        assert_eq!(p.constant_width.to_bits(), (-0.0f64).to_bits());
+    }
+}
