new file mode 100644
--- /dev/null
+++ b/tests/polyline_width_defaults.rs
@@ -0,0 +1,71 @@
+//! Classic source presence survives independently of effective numeric widths.
+use acadrust::entities::Polyline2D;
+use acadrust::{DxfReader, EntityType};
+use std::io::Cursor;
+fn classic() -> Polyline2D {
+    let doc = DxfReader::from_reader(Cursor::new(
+        include_bytes!("fixtures/polyline-width-defaults.dxf").to_vec(),
+    ))
+    .unwrap()
+    .read()
+    .unwrap();
+    let found = doc
+        .entities()
+        .find_map(|e| match e {
+            EntityType::Polyline2D(p) => Some(p.clone()),
+            _ => None,
+        })
+        .expect("classic POLYLINE");
+    found
+}
+#[test]
+fn classic_reader_preserves_header_defaults() {
+    let p = classic();
+    assert_eq!([p.start_width, p.end_width], [0.2, 0.4]);
+}
+
+#[test]
+fn classic_reader_preserves_independent_overrides() {
+    let p = classic();
+    let actual: Vec<_> = p
+        .vertices
+        .iter()
+        .map(|v| (v.start_width, v.end_width))
+        .collect();
+    assert_eq!(
+        actual,
+        vec![
+            (None, None),
+            (Some(0.0), None),
+            (None, Some(0.0)),
+            (Some(0.2), Some(0.4))
+        ]
+    );
+}
+#[test]
+fn default_edit_changes_only_inherited_leaves() {
+    let mut p = classic();
+    p.start_width = 0.6;
+    p.end_width = 0.8;
+    assert_eq!(p.effective_vertex_widths(0), Some([0.6, 0.8]));
+    assert_eq!(p.effective_vertex_widths(1), Some([0.0, 0.8]));
+    assert_eq!(p.effective_vertex_widths(2), Some([0.6, 0.0]));
+    assert_eq!(p.effective_vertex_widths(3), Some([0.2, 0.4]));
+    assert_eq!(p.effective_vertex_widths(4), None);
+    p.flags.set_closed(true);
+    assert_eq!(p.effective_vertex_widths(3), Some([0.2, 0.4]));
+}
+#[test]
+fn explicit_signed_zero_is_not_inheritance() {
+    use acadrust::entities::Vertex2D;
+    use acadrust::types::Vector3;
+    let mut p = Polyline2D::new();
+    p.start_width = 1.0;
+    p.end_width = 2.0;
+    p.add_vertex(Vertex2D::new(Vector3::ZERO));
+    p.add_vertex(Vertex2D::new(Vector3::ZERO).with_width(-0.0, 0.0));
+    assert_eq!(p.effective_vertex_widths(0), Some([1.0, 2.0]));
+    let w = p.effective_vertex_widths(1).unwrap();
+    assert_eq!(w[0].to_bits(), (-0.0f64).to_bits());
+    assert_eq!(w[1].to_bits(), 0.0f64.to_bits());
+}
