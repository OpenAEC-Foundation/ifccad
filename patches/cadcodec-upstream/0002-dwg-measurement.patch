diff --git a/src/io/dwg/template.rs b/src/io/dwg/template.rs
new file mode 100644
index 0000000..915abf9
--- /dev/null
+++ b/src/io/dwg/template.rs
@@ -0,0 +1,59 @@
+//! AcDb:Template payload (ODA DWG specification, section 22).
+//! Description length and MEASUREMENT are separate 16-bit fields.
+
+pub(crate) fn write(measurement: i16) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(4);
+    bytes.extend_from_slice(&0_i16.to_le_bytes());
+    bytes.extend_from_slice(&measurement.to_le_bytes());
+    bytes
+}
+
+pub(crate) fn read(bytes: &[u8]) -> Result<i16, String> {
+    let length = bytes
+        .get(..2)
+        .ok_or("Truncated template description length")?;
+    let length = i16::from_le_bytes([length[0], length[1]]);
+    let length = usize::try_from(length).map_err(|_| "Negative template description length")?;
+    let offset = 2 + length;
+    let value = bytes
+        .get(offset..offset + 2)
+        .ok_or("Truncated template description or MEASUREMENT")?;
+    let value = u16::from_le_bytes([value[0], value[1]]);
+    if value > 1 {
+        return Err(format!("Invalid template MEASUREMENT value {value}"));
+    }
+    Ok(value as i16)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_description_keeps_both_measurement_values() {
+        assert_eq!(write(0), [0, 0, 0, 0]);
+        assert_eq!(write(1), [0, 0, 1, 0]);
+        assert_eq!(read(&[0, 0, 0, 0]).unwrap(), 0);
+        assert_eq!(read(&[0, 0, 1, 0]).unwrap(), 1);
+    }
+
+    #[test]
+    fn skips_encoded_description_bytes() {
+        assert_eq!(read(&[3, 0, b'A', 0xe9, b'B', 1, 0]).unwrap(), 1);
+    }
+
+    #[test]
+    fn rejects_truncated_negative_and_invalid_values() {
+        for bytes in [
+            &[][..],
+            &[0],
+            &[0, 0],
+            &[0, 0, 1],
+            &[4, 0, b'x', 1, 0],
+            &[255, 255, 0, 0],
+            &[0, 0, 2, 0],
+        ] {
+            assert!(read(bytes).is_err(), "{bytes:?}");
+        }
+    }
+}
