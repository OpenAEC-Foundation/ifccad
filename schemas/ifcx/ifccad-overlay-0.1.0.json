{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ifccad.org/ifcx/ifccad-overlay-0.1.0.json",
  "title": "IFCCAD IFCX Overlay 0.1.0",
  "description": "IFCCAD-owned constraints layered over an extensible IFCX document.",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataNode"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "dataNode": {
      "type": "object",
      "additionalProperties": true
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "packageRelativeUri": {
      "type": "string",
      "minLength": 1
    }
  }
}
